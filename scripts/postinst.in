#!/bin/sh
case "$1" in
configure)
# 清除上一版本诊断日志，保证本次测试从干净状态开始
rm -f /var/mobile/ChargeControl/force.log 2>/dev/null || true
# 重启被注入的守护，让强制充电 tweak 生效
killall -9 powerd 2>/dev/null || true
killall -q thermalmonitord 2>/dev/null || true
# 限制充电守护：已有服务重启读取新配置，首次安装执行 bootstrap
if launchctl print system/com.chargecontrol.charge >/dev/null 2>&1; then
    launchctl kickstart -k system/com.chargecontrol.charge >/dev/null 2>&1 || true
else
    launchctl bootstrap system @JBROOT@/Library/LaunchDaemons/com.chargecontrol.charge.plist >/dev/null 2>&1 || true
fi
;;
esac
exit 0
