<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>ChargeControl</string>
	<key>items</key>
	<array>
		<!-- ===================== 限制充电 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>限制充电</string>
			<key>footerText</key><string>开启后达到所选电量即停充（通过 AppleSmartBattery 的 PredictiveChargingInhibit）。可选停充时同时禁流。电量下降 5% 后先恢复输入再恢复充电。与「强制充电」互斥，请勿同开。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.chargecontrol</string>
			<key>key</key><string>limitChargeEnabled</string>
			<key>label</key><string>限制充电</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSegmentCell</string>
			<key>default</key><integer>90</integer>
			<key>defaults</key><string>com.chargecontrol</string>
			<key>key</key><string>limitChargeLevel</string>
			<key>label</key><string>停充电量</string>
			<key>validTitles</key><array><string>85%</string><string>90%</string><string>95%</string><string>99%</string></array>
			<key>validValues</key><array><integer>85</integer><integer>90</integer><integer>95</integer><integer>99</integer></array>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.chargecontrol</string>
			<key>key</key><string>limitChargeUseSmartBatteryAPI</string>
			<key>label</key><string>使用 SmartBatteryAPI</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.chargecontrol</string>
			<key>key</key><string>limitChargeDisableInflow</string>
			<key>label</key><string>停充时自动禁流</string>
		</dict>

		<!-- ===================== 强制充电 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>强制充电</string>
			<key>footerText</key><string>强制满血快充：无视发热，把被热控压低的充电电流上限提回设备满量，并解除 iOS 80% 附近的涓流/优化充电截断。关闭后立即恢复系统判定。仅调试用途，可能加速电池发热。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.chargecontrol</string>
			<key>key</key><string>forceChargeEnabled</string>
			<key>label</key><string>强制满血快充（解除80%涓流）</string>
		</dict>
	</array>
</dict>
</plist>
